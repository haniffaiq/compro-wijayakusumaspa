# Salin ke apps/web/.env lalu isi. Jangan commit .env.
# Kode wajib tetap jalan saat variabel opsional kosong (AGENTS.md §11).

# Format internasional tanpa tanda plus, contoh 628xxxxxxxxxx
VITE_WHATSAPP_NUMBER=

# Origin absolut untuk canonical dan Open Graph, contoh https://wijayahomespa.com
VITE_SITE_URL=

# Opsional
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_REVIEW_URL=

# Fase 2. Kosong di v1 berarti src/data/ membaca konten statis dari src/content/
VITE_API_BASE_URL=
